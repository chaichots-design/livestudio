@echo off
setlocal
title LiveStudio Setup
set "SELF=%~f0"
set "WORK=%TEMP%\LiveStudio-Setup-%RANDOM%%RANDOM%"
echo Unpacking LiveStudio ...
powershell -NoProfile -ExecutionPolicy Bypass -Command "$t=[IO.File]::ReadAllText($env:SELF); $i=$t.LastIndexOf('::PAYLOAD::'); $b=[Convert]::FromBase64String(($t.Substring($i+11) -replace '\s','')); New-Item -ItemType Directory -Force $env:WORK | Out-Null; $z=Join-Path $env:WORK 'p.zip'; [IO.File]::WriteAllBytes($z,$b); Expand-Archive -Force $z $env:WORK"
if errorlevel 1 (
  echo [ERROR] Could not unpack the installer.
  pause
  exit /b 1
)
call "%WORK%\LiveStudio-Setup\install.bat"
rmdir /s /q "%WORK%" >nul 2>&1
exit /b 0
